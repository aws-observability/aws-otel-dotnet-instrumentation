<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Host</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClrDebug" Version="0.4.1" />
    <!-- dbgshim native lib (linux-arm64) — the entry point for out-of-process
         ICorDebug launch/attach. Not a transitive dep of ClrDebug. -->
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.linux-arm64" Version="9.0.661903" />
  </ItemGroup>
</Project>
