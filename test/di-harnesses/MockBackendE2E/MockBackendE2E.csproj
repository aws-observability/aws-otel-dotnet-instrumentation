<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Throwaway E2E: drives the REAL DynamicInstrumentationClient against a mock backend
       serving the two production endpoints, proving the agent<->backend wire loop for a
       Dotnet-language config. Not part of the build/solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MockBackendE2E</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AWS.Distro.OpenTelemetry.DynamicInstrumentation/AWS.Distro.OpenTelemetry.DynamicInstrumentation.csproj" />
  </ItemGroup>
</Project>
