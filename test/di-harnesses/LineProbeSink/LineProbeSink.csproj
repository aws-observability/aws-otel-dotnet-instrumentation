<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase-2 PoC callback sink. Deliberately a SEPARATE assembly from the target app so the
       native rewrite must build a genuine cross-assembly AssemblyRef+MemberRef (Q3), not a
       same-module ref. Plain managed static, NOT a profiler-owned type (the point of Q2). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>LineProbeSink</AssemblyName>
    <Configuration>Debug</Configuration>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
