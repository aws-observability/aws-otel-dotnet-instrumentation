<Project Sdk="Microsoft.NET.Sdk">
  <!-- ASYNC line-probe spike harness (DECISION B core). Mirrors LineProbeE2E's exit-code contract
       (exit = number of FAILED assertions). Runs an async target under the FORKED native profiler
       and asserts the injected `ldarg.0; ldfld <hoistedField>; box; call CaptureLocal` reads the
       real value of a local hoisted onto the async state machine, across an await.
       DEBUG build, portable PDB, net8.0, NOT ReadyToRun. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AsyncLineProbeE2E</AssemblyName>
    <Configuration>Debug</Configuration>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- Callback sink lives in a SEPARATE assembly, forcing a genuine cross-assembly MemberRef. -->
    <ProjectReference Include="../LineProbeSink/LineProbeSink.csproj" />
  </ItemGroup>
</Project>
